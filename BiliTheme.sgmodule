#!name=哔哩主题 (BiliTheme)
#!desc=B站装扮商城详情页原生衣服图标一键注入主题皮肤。修复Surge机制冲突。
#!system=ios

[Rule]
# 阻断 B 站的 QUIC (HTTP/3) UDP 流量，强制回退到 Surge 可以抓包的 TCP 流量
AND,((PROTOCOL,UDP), (DEST-PORT,443), (DOMAIN-SUFFIX,bilibili.com)),REJECT-NO-DROP

[Script]
哔哩主题API = type=http-request, pattern=^https:\/\/app\.bilibili\.com\/settings\/theme\/api\/(select|config), requires-body=true, max-size=3145728, script-path=https://raw.githubusercontent.com/asd3739058-tech/surge-rules/refs/heads/main/bili-api.js

哔哩主题响应 = type=http-response, pattern=^https:\/\/(www\.bilibili\.com\/h5\/mall\/(digital-card\/home|suit\/detail)|app\.bilibili\.com\/x\/(resource\/show\/skin|v2\/(space|splash\/brand\/list))), requires-body=true, max-size=3145728, argument="spaceBg=true,splashBg=true", script-path=https://raw.githubusercontent.com/asd3739058-tech/surge-rules/refs/heads/main/bili-response.js

[MITM]
hostname = %APPEND% app.bilibili.com, www.bilibili.com
